# =============================================================================
# Server
# =============================================================================

# Backend bind address and port.
# For public deployments behind nginx, keep HOST bound to localhost.
HOST=127.0.0.1
PORT=3000

# Frontend development server port.
FRONTEND_PORT=5173

# =============================================================================
# Authentication and sessions
# =============================================================================

PI_CLOUD_AUTH_USERNAME=yourname

# Development or simple setups only. Prefer PI_CLOUD_AUTH_PASSWORD_HASH in production.
PI_CLOUD_AUTH_PASSWORD=change-me-for-dev-only
# PI_CLOUD_AUTH_PASSWORD_HASH=$scrypt$ln=15,r=8,p=3$...

# Active sessions renew before the idle timeout, up to the absolute maximum lifetime.
PI_CLOUD_SESSION_TTL_HOURS=8
PI_CLOUD_SESSION_MAX_HOURS=720

# Set true only when the app is served exclusively over HTTPS.
PI_CLOUD_COOKIE_SECURE=false

# Enable only when requests always pass through a trusted reverse proxy.
PI_CLOUD_TRUST_PROXY=false

# Emergency 2FA recovery only. Keep false during normal operation.
SKIP_2FA_VERIFY=false


# =============================================================================
# Storage, filesystem, and terminal
# =============================================================================

# Custom SQLite database path. Defaults to the user configuration directory.
# PI_CLOUD_DB_PATH=/home/youruser/.config/pi-cloud/pi-cloud.sqlite

# Comma-separated directories the file browser and terminal may access.
# Defaults to the current user's home directory.
# PI_CLOUD_ALLOWED_ROOTS=/home/youruser/git/github,/home/youruser/projects

# Disable allowed-root checks. Defaults to true on Windows and false on macOS/Linux.
# PI_CLOUD_DISABLE_PATH_CHECK=false

# Allow "Open with system tool" through non-localhost URLs, such as a local nginx hostname.
# This launches applications on the machine running Pi Cloud.
PI_CLOUD_ENABLE_SYSTEM_OPEN=false

# Terminal shell executable, such as powershell.exe, pwsh.exe, or /bin/zsh.
# PI_CLOUD_TERMINAL_SHELL=pwsh.exe

# Memory extraction/recall policy. Defaults to adaptive-lexical-v1; use legacy to roll back.
# PI_CLOUD_MEMORY_POLICY=legacy


# =============================================================================
# AI providers
# =============================================================================

# Comma-separated exact origins permitted for non-loopback local LLM endpoints.
# Loopback endpoints are allowed by default.
# PI_CLOUD_LOCAL_LLM_ALLOWED_ORIGINS=http://192.168.1.20:11434,https://llm.example.test

# Provider API keys (uncomment as needed).
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
# DEEPSEEK_API_KEY=...
# GROQ_API_KEY=...
# XIAOMI_API_KEY=...

# Azure OpenAI.
# AZURE_OPENAI_BASE_URL=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_VERSION=v1

# AWS Bedrock.
# AWS_REGION=us-east-1
# AWS_PROFILE=default

# Browser voice dictation uses an independent OpenAI-compatible speech-to-text endpoint.
# It falls back to OPENAI_API_KEY when PI_CLOUD_STT_API_KEY is unset.
# PI_CLOUD_STT_API_KEY=sk-...
# PI_CLOUD_STT_BASE_URL=https://api.openai.com/v1
# PI_CLOUD_STT_MODEL=gpt-4o-mini-transcribe
# Optional ISO-639-1 language hint, for example zh or en. Leave unset for auto-detection.
# PI_CLOUD_STT_LANGUAGE=zh


# =============================================================================
# Messaging gateways
# =============================================================================

# Optional shared gateway defaults.
# Configure profile, skillset, model, and allowed folders in Settings > Gateway.
# PI_CLOUD_GATEWAY_COMMAND_PREFIX=小助理

# Feishu/Lark callback.
# Event subscription URL: https://your-domain/api/gateways/feishu/events
# PI_CLOUD_FEISHU_APP_ID=cli_xxx
# PI_CLOUD_FEISHU_APP_SECRET=xxx
# Verification token is required; encrypt key is required for encrypted callbacks.
# PI_CLOUD_FEISHU_VERIFICATION_TOKEN=xxx
# PI_CLOUD_FEISHU_ENCRYPT_KEY=xxx
# PI_CLOUD_FEISHU_DOMAIN=feishu

# WeCom self-built application. Prefer Settings > Gateway for guided setup.
# Callback URL: https://your-domain/api/gateways/wecom/callback
# Environment variables override saved UI configuration and make it read-only.
# PI_CLOUD_WECOM_CORP_ID=wwxxxxxxxxxxxxxxxx
# PI_CLOUD_WECOM_CORP_SECRET=xxx
# PI_CLOUD_WECOM_AGENT_ID=1000002
# PI_CLOUD_WECOM_CALLBACK_TOKEN=32-character-token
# PI_CLOUD_WECOM_ENCODING_AES_KEY=43-character-encoding-aes-key
# Comma-separated WeCom member User IDs; leave unset or empty to allow all members.
# PI_CLOUD_WECOM_ALLOWED_USERS=user_id_1,user_id_2

# WeChat/Weixin (Tencent iLink long-polling, text DMs).
# Disabled by default; enabling it requires an account ID and token.
PI_CLOUD_WECHAT_GATEWAY_ENABLED=false
# PI_CLOUD_WECHAT_ACCOUNT_ID=your-account-id
# PI_CLOUD_WECHAT_TOKEN=your-bot-token
# PI_CLOUD_WECHAT_BASE_URL=https://ilinkai.weixin.qq.com

# DM policies: pairing, allowlist, open, or disabled.
# PI_CLOUD_WECHAT_DM_POLICY=pairing
# PI_CLOUD_WECHAT_ALLOWED_USERS=user_id_1,user_id_2
# Required only when PI_CLOUD_WECHAT_DM_POLICY=open.
# PI_CLOUD_WECHAT_ALLOW_ALL_USERS=false
